<!DOCTYPE html>
<html lang="ru">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta charset="UTF-8">
    <title>MEXC PRO TERMINAL</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
    <style>
        /* ── OHLCV overlay: override chart-container > div rule ── */
        #ohlcvBar {
            width: auto !important;
            height: auto !important;
            position: absolute;
            top: 10px;
            left: 14px;
            z-index: 10;
            display: flex;
            gap: 16px;
            align-items: center;
            pointer-events: none;
            user-select: none;
            flex-wrap: wrap;
        }
        #ohlcvBar span {
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--text-muted);
        }
        #ohlcvBar span b {
            font-weight: 600;
        }

        /* ── Price header ── */
        #priceHeader {
            display: flex;
            align-items: center;
            gap: 16px;
            font-family: var(--font-mono);
        }
        #hPrice {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: 0.5px;
        }
        #hChange {
            font-size: 13px;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: 600;
        }
        #hChange.up   { background: rgba(0,229,146,0.12); color: var(--green); }
        #hChange.down { background: rgba(255,73,118,0.12); color: var(--red);   }

        /* ── Extra timeframe buttons ── */
        .tf-sep {
            width: 1px;
            height: 16px;
            background: var(--border);
        }

        /* ── Chart container tweak so overlay works ── */
        .chart-container {
            position: relative; /* already set in style.css, but be explicit */
        }
        #chartInner {
            position: absolute;
            inset: 0;
        }

        /* ── Индикаторы: меню, легенда оверлеев, панели осцилляторов ── */
        .ind-wrap { position: relative; }
        #indMenu {
            display: none; position: absolute; top: calc(100% + 4px); right: 0; width: 290px; max-height: 70vh; overflow-y: auto;
            background: var(--bg-panel); border: 1px solid var(--border); border-radius: 6px; z-index: 999;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5); padding: 6px 0;
        }
        #indMenu.open { display: block; }
        #indMenu .ind-group { padding: 6px 12px 2px; font-size: 10px; letter-spacing: 1px; color: var(--text-muted); text-transform: uppercase; }
        #indMenu label { display: flex; align-items: center; gap: 8px; padding: 5px 12px; font-size: 12px; cursor: pointer; }
        #indMenu label:hover { background: var(--bg-hover); }
        #indMenu label.disabled { opacity: 0.4; cursor: not-allowed; }
        #indLegend {
            width: auto !important; height: auto !important; position: absolute; top: 30px; left: 14px; z-index: 10;
            display: flex; flex-direction: column; gap: 2px; pointer-events: none; user-select: none;
            font-family: var(--font-mono); font-size: 11px;
        }
        #paneStack { display: flex; flex-direction: column; flex-shrink: 0; }
        .osc-pane { position: relative; height: 120px; border-top: 1px solid var(--border); }
        .osc-pane .pane-title {
            position: absolute; top: 4px; left: 14px; z-index: 5; pointer-events: none;
            font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);
        }
        .osc-pane .pane-chart { position: absolute; inset: 0; }
        @media (max-width: 900px) { .osc-pane { height: 140px; } #indMenu { width: 250px; } }

        /* ── Volume color crosshair ── */
        .ob-mid { transition: color 0.2s; }

        /* ── Watermark override (hidden by default — LW handles it) ── */
    </style>
</head>
<body>

<!-- ────────────────────────── Header ────────────────────────── -->
<div class="header">
    <div style="display:flex; align-items:center; gap:20px;">
        <div class="logo">MEXC <span>PRO</span></div>
        <%- include("../partials/navigation", { activePage: activePage }) %>
    </div>

    <!-- Live price display -->
    <div id="priceHeader">
        <span id="hPrice">—</span>
        <span id="hChange" class="up">—</span>
        <span id="hHigh"  style="font-family:var(--font-mono); font-size:12px; color:var(--text-muted);">H: —</span>
        <span id="hLow"   style="font-family:var(--font-mono); font-size:12px; color:var(--text-muted);">L: —</span>
    </div>

    <div class="toolbar">
        <div class="search-wrap">
            <input type="text" id="symbolInput" class="search-input"
                   value="BTCUSDT" placeholder="Поиск пары..." autocomplete="off">
            <div class="search-dropdown" id="searchDropdown"></div>
        </div>
        <div style="width:1px;height:20px;background:var(--border);margin:0 10px;"></div>

        <!-- Timeframe buttons -->
        <button class="btn tf-btn active" data-tf="1m"  data-sec="60">1m</button>
        <button class="btn tf-btn"        data-tf="5m"  data-sec="300">5m</button>
        <button class="btn tf-btn"        data-tf="15m" data-sec="900">15m</button>
        <button class="btn tf-btn"        data-tf="60m" data-sec="3600">1H</button>
        <div class="tf-sep"></div>
        <button class="btn tf-btn"        data-tf="4h"  data-sec="14400">4H</button>
        <button class="btn tf-btn"        data-tf="1d"  data-sec="86400">1D</button>
        <div style="width:1px;height:20px;background:var(--border);margin:0 10px;"></div>

        <!-- Indicators menu -->
        <div class="ind-wrap">
            <button class="btn" id="indBtn" type="button">ƒ Индикаторы <span id="indCount"></span></button>
            <div id="indMenu"></div>
        </div>
    </div>
</div>

<!-- ────────────────────────── Main grid ────────────────────────── -->
<div class="main-grid">

    <!-- Left column -->
    <div class="left-col">

        <!-- ── Candlestick chart + OHLCV overlay ── -->
        <div class="chart-container">
            <!-- OHLCV info bar (top-left overlay, TradingView-style) -->
            <div id="ohlcvBar">
                <span id="oSym" style="color:var(--text-main); font-weight:700; font-size:13px;"></span>
                <span>O:&nbsp;<b id="oO" style="color:var(--text-main)">—</b></span>
                <span>H:&nbsp;<b id="oH" style="color:var(--green)">—</b></span>
                <span>L:&nbsp;<b id="oL" style="color:var(--red)">—</b></span>
                <span>C:&nbsp;<b id="oC">—</b></span>
                <span>V:&nbsp;<b id="oVol" style="color:#94a3b8">—</b></span>
                <span id="oPct" style="font-size:11px; padding:2px 6px; border-radius:3px;"></span>
            </div>
            <!-- Легенда включённых индикаторов поверх свечей -->
            <div id="indLegend"></div>
            <!-- Chart fills container -->
            <div id="chartInner"></div>
        </div>

        <!-- ── BID/ASK indicator header ── -->
        <div class="indicator-header">
            <span class="ind-title">BID/ASK SPOT TOTAL</span>
            <div class="ind-legend">
                <span id="legBid" class="leg-item c-green">BID — $0</span>
                <span id="legAsk" class="leg-item" style="color:#F59E0B;">ASK — $0</span>
                <span id="legDiff" class="leg-item" style="color:#94a3b8;">DIFF — $0</span>
            </div>
        </div>

        <!-- ── BID/ASK indicator chart ── -->
        <div class="indicator-container" id="indicatorChart"></div>

        <!-- ── Панели осцилляторов (RSI, MACD) ── -->
        <div id="paneStack"></div>

        <!-- ── Metrics bar ── -->
        <div class="metrics-bar">
            <div class="metric-box">
                <div class="m-title">BID LIMITS (USD)</div>
                <div class="m-value c-green" id="vBid">$0</div>
            </div>
            <div class="metric-box">
                <div class="m-title">ASK LIMITS (USD)</div>
                <div class="m-value c-red" id="vAsk">$0</div>
            </div>
            <div class="metric-box">
                <div class="m-title">IMBALANCE</div>
                <div class="m-value" id="vImb">1.00x</div>
            </div>
        </div>

        <div id="log">System initializing...</div>
    </div>

    <!-- ── Right column: Order Book ── -->
    <div class="right-col">
        <div class="ob-header">Order Book (Depth 5%)</div>
        <div class="ob-table-head">
            <span>Price (USDT)</span>
            <span>Amount</span>
            <span>Total (USD)</span>
        </div>
        <div class="ob-list">
            <div class="ob-asks" id="obAsks"></div>
            <div class="ob-mid"  id="obMidPrice">0.00</div>
            <div class="ob-bids" id="obBids"></div>
        </div>
    </div>
</div>

<!-- ════════════════════════ JavaScript ════════════════════════ -->
<script>
// ── State ────────────────────────────────────────────────────────────────
const urlParams = new URLSearchParams(window.location.search);
let symbol      = urlParams.get('symbol') || 'BTCUSDT';
let interval    = '1m';
let tfSec       = 60;
let allSymbols  = [];

let chart, candleSeries, volumeSeries;
// Индикаторы: каталог с сервера, включённые id (запоминаются в браузере), серии на графиках
let indicatorCatalog = [];
let enabledIndicators = new Set();
const overlaySeries = {};   // id -> [LineSeries] поверх свечей
const panes = {};           // id -> { el, chart, series[] } отдельные панели
let indicatorRequestId = 0;
try { enabledIndicators = new Set(JSON.parse(localStorage.getItem('enabledIndicators') || '[]')); } catch (e) {}
let indicatorChart, bidLine, askLine;
let syncingMain = false, syncingInd = false;

// Tracks the live candle state so update() preserves open/high/low
let currentCandle = null;  // { time, open, high, low, close, volume }

const $ = id => document.getElementById(id);

// ── Helpers ───────────────────────────────────────────────────────────────
function writeLog(m) {
    $('log').innerText = `[${new Date().toLocaleTimeString()}] ${m}`;
}

function fmtPrice(p) {
    if (!p && p !== 0) return '—';
    if (p >= 10000)  return p.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (p >= 1)      return p.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    if (p >= 0.01)   return p.toFixed(5);
    return p.toFixed(8);
}

function fmtNum(n) {
    if (n >= 1e9) return (n/1e9).toFixed(2)+'B';
    if (n >= 1e6) return (n/1e6).toFixed(2)+'M';
    if (n >= 1e3) return (n/1e3).toFixed(1)+'K';
    return n.toFixed(1);
}

function fmtLeg(n) { return '$' + fmtNum(n); }

// ── Search autocomplete ──────────────────────────────────────────────────
async function loadSymbols() {
    try {
        allSymbols = await (await fetch('/api/symbols')).json();
    } catch(e) {
        allSymbols = ['BTCUSDT','ETHUSDT','SOLUSDT'];
    }
}

function showDropdown(query) {
    const dd   = $('searchDropdown');
    const q    = query.toUpperCase();
    if (!q) { dd.style.display = 'none'; return; }
    const matches = allSymbols.filter(s => s.startsWith(q) || s.includes(q)).slice(0, 10);
    if (!matches.length) { dd.style.display = 'none'; return; }
    dd.innerHTML = matches.map(s => {
        const base = s.replace(/USDT$/, '');
        return `<div class="dd-item" data-symbol="${s}">
            <span class="dd-base">${base}</span><span class="dd-quote">/USDT</span>
        </div>`;
    }).join('');
    dd.style.display = 'block';
    dd.querySelectorAll('.dd-item').forEach(el =>
        el.addEventListener('mousedown', e => { e.preventDefault(); selectSymbol(el.dataset.symbol); })
    );
}

function selectSymbol(sym) {
    $('symbolInput').value = sym;
    $('searchDropdown').style.display = 'none';
    symbol = sym;
    currentCandle = null;
    candleSeries.setData([]);
    volumeSeries.setData([]);
    bidLine.setData([]);
    askLine.setData([]);
    $('obAsks').innerHTML = '';
    $('obBids').innerHTML = '';
    $('oSym').textContent = sym.replace('USDT', '/USDT');
    clearAllIndicators();
    loadKlines();
    loadHistory();
    refreshIndicators();
    tick();
    writeLog(`Загрузка ${sym}...`);
}

document.addEventListener('DOMContentLoaded', () => {
    const inp = $('symbolInput');
    
    // Обработчики ввода и фокуса
    inp.addEventListener('input',  () => showDropdown(inp.value));
    inp.addEventListener('focus',  () => showDropdown(inp.value));
    inp.addEventListener('blur',   () => setTimeout(() => { $('searchDropdown').style.display='none'; }, 150));
    
    // Управление списком с клавиатуры
    inp.addEventListener('keydown', e => {
        const dd    = $('searchDropdown');
        const items = dd.querySelectorAll('.dd-item');
        const active = dd.querySelector('.dd-item.hovered');
        
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            const next = active ? (active.nextElementSibling || items[0]) : items[0];
            if (active) active.classList.remove('hovered');
            if (next) { next.classList.add('hovered'); inp.value = next.dataset.symbol; }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prev = active ? (active.previousElementSibling || items[items.length-1]) : items[items.length-1];
            if (active) active.classList.remove('hovered');
            if (prev) { prev.classList.add('hovered'); inp.value = prev.dataset.symbol; }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            const sym = active ? active.dataset.symbol : inp.value.toUpperCase().trim();
            if (sym) selectSymbol(sym);
        } else if (e.key === 'Escape') {
            dd.style.display = 'none';
        }
    });

    // ── Мобильная адаптация ──
    // Скрываем выпадающий список и убираем фокус (прячем экранную клавиатуру) 
    // при любой попытке прокрутить страницу вниз
    window.addEventListener('scroll', () => {
        $('searchDropdown').style.display = 'none';
        inp.blur();
    }, { passive: true });
});

// ── Chart initialisation ─────────────────────────────────────────────────
function initChart() {

    // ── Main candlestick chart ──
    const chartEl = $('chartInner');

    chart = LightweightCharts.createChart(chartEl, {
        autoSize: true,
        layout: {
            background:  { color: '#0b0e14' },
            textColor:   '#64748b',
            fontFamily:  "'IBM Plex Mono', monospace",
        },
        grid: {
            vertLines: { color: '#151822', style: 0 },
            horzLines: { color: '#151822', style: 0 },
        },
        rightPriceScale: {
            borderColor: '#222633',
            scaleMargins: { top: 0.06, bottom: 0.22 },  // leave room for volume
        },
        timeScale: {
            borderColor:  '#222633',
            timeVisible:  true,
            secondsVisible: false,
            fixLeftEdge:  false,
            fixRightEdge: false,
            rightOffset:  8,
        },
        crosshair: {
            mode: LightweightCharts.CrosshairMode.Normal,
            vertLine: { color: '#334155', labelBackgroundColor: '#1e2230', width: 1, style: 0 },
            horzLine: { color: '#334155', labelBackgroundColor: '#1e2230', width: 1, style: 0 },
        },
        localization: {
            priceFormatter: fmtPrice,
        },
    });

    // Candlestick series
    candleSeries = chart.addCandlestickSeries({
        upColor:        '#00E592',
        downColor:      '#FF4976',
        wickUpColor:    '#00E592',
        wickDownColor:  '#FF4976',
        borderVisible:  false,
        priceLineVisible: true,
        priceLineWidth:   1,
        priceLineColor:   '#334155',
        priceLineStyle:   LightweightCharts.LineStyle.Dashed,
        lastValueVisible: true,
    });

    // Volume histogram (overlay on same chart, separate scale)
    volumeSeries = chart.addHistogramSeries({
        priceFormat:  { type: 'volume' },
        priceScaleId: 'vol',
    });
    chart.priceScale('vol').applyOptions({
        scaleMargins: { top: 0.78, bottom: 0 },
        visible: false,
    });

    // ── BID/ASK indicator chart ──
    const indEl = $('indicatorChart');

    indicatorChart = LightweightCharts.createChart(indEl, {
        autoSize: true,
        layout: {
            background: { color: '#0b0e14' },
            textColor:  '#64748b',
            fontFamily: "'IBM Plex Mono', monospace",
        },
        grid: {
            vertLines: { color: '#151822' },
            horzLines: { color: '#151822' },
        },
        rightPriceScale: {
            borderColor:   '#222633',
            scaleMargins:  { top: 0.1, bottom: 0.1 },
        },
        timeScale: {
            borderColor:    '#222633',
            timeVisible:    true,
            secondsVisible: false,
            visible: false,   // time axis on the indicator is redundant (main chart shows it)
        },
        crosshair: {
            mode: LightweightCharts.CrosshairMode.Normal,
            vertLine: { color: '#334155', labelBackgroundColor: '#1e2230', width: 1, style: 0 },
            horzLine: { color: '#334155', labelBackgroundColor: '#1e2230', width: 1, style: 0 },
        },
    });

    // BID line (green)
    bidLine = indicatorChart.addLineSeries({
        color:            '#00E592',
        lineWidth:        2,
        lastValueVisible: true,
        priceLineVisible: false,
        title:            'BID',
    });

    // ASK line (orange)
    askLine = indicatorChart.addLineSeries({
        color:            '#F59E0B',
        lineWidth:        2,
        lastValueVisible: true,
        priceLineVisible: false,
        title:            'ASK',
    });

    // ── Sync timescales (основной график, BID/ASK и панели индикаторов) ──
    linkRange(chart);
    linkRange(indicatorChart);

    // ── Crosshair sync + OHLCV overlay ──
    chart.subscribeCrosshairMove(param => {
        // Update OHLCV overlay
        if (param.time) {
            const candle = param.seriesData.get(candleSeries);
            const vol    = param.seriesData.get(volumeSeries);
            if (candle) updateOhlcvBar(candle, vol ? vol.value : null);

            // Sync to indicator
            if (!syncingMain) {
                syncingMain = true;
                indicatorChart.setCrosshairPosition(0, param.time, bidLine);
                syncingMain = false;
            }
        } else {
            // Restore to last candle
            if (currentCandle) updateOhlcvBar(currentCandle, currentCandle.volume);
            indicatorChart.clearCrosshairPosition();
        }
    });

    indicatorChart.subscribeCrosshairMove(param => {
        if (!param.time) return;
        if (!syncingInd) {
            syncingInd = true;
            chart.setCrosshairPosition(0, param.time, candleSeries);
            syncingInd = false;
        }
    });
}

// ── Синхронизация диапазона времени между всеми графиками ────────────────
let syncingRange = false;
function allCharts() { return [chart, indicatorChart, ...Object.values(panes).map(p => p.chart)]; }
function linkRange(source) {
    source.timeScale().subscribeVisibleLogicalRangeChange(range => {
        if (syncingRange || !range) return;
        syncingRange = true;
        allCharts().forEach(c => { if (c !== source) c.timeScale().setVisibleLogicalRange(range); });
        syncingRange = false;
    });
}

// ── OHLCV overlay update ─────────────────────────────────────────────────
function updateOhlcvBar(candle, vol) {
    const { open, high, low, close } = candle;
    const pct   = ((close - open) / open) * 100;
    const color = close >= open ? 'var(--green)' : 'var(--red)';

    $('oO').textContent    = fmtPrice(open);
    $('oH').textContent    = fmtPrice(high);
    $('oL').textContent    = fmtPrice(low);
    $('oC').textContent    = fmtPrice(close);
    $('oC').style.color    = color;
    $('oVol').textContent  = vol != null ? fmtNum(vol) : '—';

    const pctEl = $('oPct');
    pctEl.textContent    = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
    pctEl.style.color    = close >= open ? 'var(--green)' : 'var(--red)';
    pctEl.style.background = close >= open ? 'rgba(0,229,146,0.1)' : 'rgba(255,73,118,0.1)';
}


// ══════════════════════ Индикаторы ══════════════════════════════════════
function saveEnabledIndicators() {
    try { localStorage.setItem('enabledIndicators', JSON.stringify([...enabledIndicators])); } catch (e) {}
}

function supportedOnInterval(item) {
    return !item.intervals || item.intervals.includes(interval);
}

function renderIndicatorMenu() {
    const groups = {};
    indicatorCatalog.forEach(item => { (groups[item.group || 'Прочее'] = groups[item.group || 'Прочее'] || []).push(item); });
    $('indMenu').innerHTML = Object.entries(groups).map(([group, items]) =>
        `<div class="ind-group">${group}</div>` + items.map(item => {
            const ok = supportedOnInterval(item);
            const hint = ok ? item.description : `${item.description} (недоступно на ${interval})`;
            return `<label class="${ok ? '' : 'disabled'}" title="${hint.replace(/"/g, '&quot;')}">
                <input type="checkbox" data-ind="${item.id}" ${enabledIndicators.has(item.id) ? 'checked' : ''} ${ok ? '' : 'disabled'}>
                <span>${item.label}</span></label>`;
        }).join('')
    ).join('');
    $('indMenu').querySelectorAll('input[data-ind]').forEach(box => box.addEventListener('change', () => {
        if (box.checked) enabledIndicators.add(box.dataset.ind); else enabledIndicators.delete(box.dataset.ind);
        saveEnabledIndicators();
        updateIndicatorCount();
        refreshIndicators();
    }));
    updateIndicatorCount();
}

function updateIndicatorCount() {
    const active = indicatorCatalog.filter(i => enabledIndicators.has(i.id) && supportedOnInterval(i)).length;
    $('indCount').textContent = active ? `(${active})` : '';
}

async function loadIndicatorCatalog() {
    try {
        indicatorCatalog = await (await fetch('/api/indicators/catalog')).json();
    } catch (e) { indicatorCatalog = []; }
    renderIndicatorMenu();
    refreshIndicators();
}

function lineOptions(line) {
    return {
        color: line.color, lineWidth: 1, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
        lineStyle: line.style === 'dashed' ? LightweightCharts.LineStyle.Dashed : LightweightCharts.LineStyle.Solid,
    };
}

function removeOverlay(id) {
    (overlaySeries[id] || []).forEach(s => chart.removeSeries(s));
    delete overlaySeries[id];
    if (id === 'rinar') candleSeries.setMarkers([]);
}

function removePane(id) {
    if (!panes[id]) return;
    panes[id].chart.remove();
    panes[id].el.remove();
    delete panes[id];
}

function ensurePane(id, title) {
    if (panes[id]) return panes[id];
    const el = document.createElement('div');
    el.className = 'osc-pane';
    el.innerHTML = `<div class="pane-title"></div><div class="pane-chart"></div>`;
    $('paneStack').appendChild(el);
    const paneChart = LightweightCharts.createChart(el.querySelector('.pane-chart'), {
        autoSize: true,
        layout: { background: { color: '#0b0e14' }, textColor: '#64748b', fontFamily: "'IBM Plex Mono', monospace" },
        grid: { vertLines: { color: '#151822' }, horzLines: { color: '#151822' } },
        rightPriceScale: { borderColor: '#222633', scaleMargins: { top: 0.15, bottom: 0.1 } },
        timeScale: { borderColor: '#222633', timeVisible: true, secondsVisible: false, visible: false },
        crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
    });
    panes[id] = { el, chart: paneChart, series: [], title };
    linkRange(paneChart);
    return panes[id];
}

const fmtInd = v => (Math.abs(v) >= 100 ? v.toFixed(2) : Math.abs(v) >= 1 ? v.toFixed(3) : v.toPrecision(4));

function applyOverlay(out) {
    removeOverlay(out.id);
    overlaySeries[out.id] = out.lines.map(line => {
        const series = chart.addLineSeries(lineOptions(line));
        series.setData(line.points);
        return series;
    });
    if (out.id === 'rinar') candleSeries.setMarkers(out.markers || []);
}

function applyPane(out, label) {
    const pane = ensurePane(out.id, label);       // панель переиспользуется: меняем только серии (без мигания)
    pane.series.forEach(series => pane.chart.removeSeries(series));
    pane.series = [];
    const last = [];
    if (out.histogram) {
        const hist = pane.chart.addHistogramSeries({ priceLineVisible: false, lastValueVisible: false, priceFormat: { type: 'price', precision: 6, minMove: 0.000001 } });
        hist.setData(out.histogram);
        pane.series.push(hist);
    }
    out.lines.forEach((line, i) => {
        const series = pane.chart.addLineSeries({ ...lineOptions(line), lineWidth: 2, lastValueVisible: true,
            ...(out.range ? { autoscaleInfoProvider: () => ({ priceRange: { minValue: out.range[0], maxValue: out.range[1] } }) } : {}) });
        series.setData(line.points);
        if (i === 0) (out.levels || []).forEach(level => series.createPriceLine({ price: level, color: '#475569', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: '' }));
        pane.series.push(series);
        const lastPoint = line.points[line.points.length - 1];
        if (lastPoint) last.push(`${line.label}: ${fmtInd(lastPoint.value)}`);
    });
    pane.el.querySelector('.pane-title').textContent = last.join('   ');
    const range = chart.timeScale().getVisibleLogicalRange();
    if (range) pane.chart.timeScale().setVisibleLogicalRange(range);
}

function renderOverlayLegend(result) {
    const rows = [];
    Object.values(result.indicators).filter(o => o.placement === 'overlay').forEach(o => {
        o.lines.forEach(line => {
            const last = line.points[line.points.length - 1];
            rows.push(`<span style="color:${line.color}">● ${line.label}${last ? ': ' + fmtPrice(last.value) : ''}</span>`);
        });
    });
    $('indLegend').innerHTML = rows.join('');
}

function clearAllIndicators() {
    Object.keys(overlaySeries).forEach(removeOverlay);
    Object.keys(panes).forEach(removePane);
    $('indLegend').innerHTML = '';
}

async function refreshIndicators() {
    const names = indicatorCatalog.filter(i => enabledIndicators.has(i.id) && supportedOnInterval(i)).map(i => i.id);
    const requestId = ++indicatorRequestId;
    if (!names.length) { clearAllIndicators(); return; }
    try {
        const res = await fetch(`/api/indicators?symbol=${symbol}&interval=${interval}&names=${names.join(',')}&limit=200`);
        const body = await res.json();
        if (requestId !== indicatorRequestId) return;           // пришёл устаревший ответ (пара/таймфрейм уже сменились)
        if (!res.ok) { writeLog('Индикаторы: ' + (body.error || res.status)); return; }
        const wanted = new Set(names);
        Object.keys(overlaySeries).filter(id => !wanted.has(id)).forEach(removeOverlay);
        Object.keys(panes).filter(id => !wanted.has(id)).forEach(removePane);
        names.forEach(id => {
            const out = body.indicators[id];
            if (!out) return;
            if (out.placement === 'pane') applyPane(out, indicatorCatalog.find(i => i.id === id)?.label || id);
            else applyOverlay(out);
        });
        renderOverlayLegend(body);
    } catch (e) {
        if (requestId === indicatorRequestId) writeLog('Индикаторы: ошибка загрузки');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    $('indBtn').addEventListener('click', e => { e.stopPropagation(); $('indMenu').classList.toggle('open'); });
    document.addEventListener('click', e => { if (!$('indMenu').contains(e.target)) $('indMenu').classList.remove('open'); });
});

// ── Data loading ─────────────────────────────────────────────────────────
async function loadKlines() {
    try {
        writeLog(`Загрузка свечей [${interval}]...`);
        const res  = await fetch(`/api/klines?symbol=${symbol}&interval=${interval}`);
        const data = await res.json();

        const candles = data.map(d => ({
            time:   d[0] / 1000,
            open:   parseFloat(d[1]),
            high:   parseFloat(d[2]),
            low:    parseFloat(d[3]),
            close:  parseFloat(d[4]),
            volume: parseFloat(d[5]),        // base-asset volume
        }));

        const volumes = candles.map(c => ({
            time:  c.time,
            value: c.volume,
            color: c.close >= c.open
                ? 'rgba(0,229,146,0.5)'
                : 'rgba(255,73,118,0.5)',
        }));

        candleSeries.setData(candles);
        volumeSeries.setData(volumes);

        if (candles.length > 0) {
            currentCandle = { ...candles[candles.length - 1] };
            updateOhlcvBar(currentCandle, currentCandle.volume);
            // Update 24h high/low from klines (last 1440 candles @ 1m ≈ 24h)
            const highs = candles.map(c => c.high);
            const lows  = candles.map(c => c.low);
            $('hHigh').textContent = 'H: ' + fmtPrice(Math.max(...highs));
            $('hLow').textContent  = 'L: ' + fmtPrice(Math.min(...lows));
        }

        chart.timeScale().fitContent();
        writeLog(`Загружено ${candles.length} свечей`);
    } catch(e) {
        writeLog('Ошибка загрузки свечей.');
    }
}

async function loadHistory() {
    try {
        // Запрашиваем данные за окно = 200 свечей текущего таймфрейма,
        // но не более 7 дней (TTL MongoDB).
        // Агрегируем на сервере по корзинам tfSec секунд —
        // одна точка BID/ASK на одну свечу.
        const windowSec = Math.min(200 * tfSec, 7 * 24 * 3600);
        const since     = Math.floor(Date.now() / 1000) - windowSec;
        const url = `/api/history?symbol=${symbol}&since=${since}&bucket=${tfSec}&limit=500`;

        const res  = await fetch(url);
        const data = res.ok ? await res.json() : [];
        const src  = res.headers.get('X-History-Source') || '—';
        writeLog(`История индикатора: ${Array.isArray(data) ? data.length : 0} точек (${src})`);

        if (Array.isArray(data) && data.length > 0) {
            const bidData = data.map(d => ({
                time:  Math.floor(new Date(d.timestamp).getTime() / 1000),
                value: d.bidUSD
            }));
            const askData = data.map(d => ({
                time:  Math.floor(new Date(d.timestamp).getTime() / 1000),
                value: d.askUSD
            }));

            bidLine.setData(bidData);
            askLine.setData(askData);
            indicatorChart.timeScale().fitContent();

            const last = data[data.length - 1];
            updateLegend(last.bidUSD, last.askUSD);
        }
    } catch(e) {}
}

function updateLegend(bidUSD, askUSD) {
    const diff = bidUSD - askUSD;
    $('legBid').textContent   = 'BID — '  + fmtLeg(bidUSD);
    $('legAsk').textContent   = 'ASK — '  + fmtLeg(askUSD);
    $('legDiff').style.color  = diff > 0 ? 'var(--green)' : diff < 0 ? 'var(--red)' : '#94a3b8';
    $('legDiff').textContent  = 'DIFF — ' + (diff >= 0 ? '+' : '') + fmtLeg(diff);
}

// ── Order book render ─────────────────────────────────────────────────────
function renderOrderBook(book, currentPrice) {
    $('obMidPrice').innerText = fmtPrice(currentPrice);

    const asks    = book.asks.slice(0, 15).reverse();
    const maxAsk  = Math.max(...asks.map(a => parseFloat(a[0]) * parseFloat(a[1])));
    let htmlAsk   = '', askTot = 0;
    asks.forEach(a => {
        const p = parseFloat(a[0]), v = parseFloat(a[1]), usd = p * v;
        askTot += usd;
        const w = Math.round((usd / maxAsk) * 100);
        htmlAsk += `<div class="ob-row">
            <div class="ob-bg bg-red" style="width:${w}%"></div>
            <span class="c-red">${fmtPrice(p)}</span>
            <span>${v.toFixed(3)}</span>
            <span>${fmtNum(askTot)}</span>
        </div>`;
    });
    $('obAsks').innerHTML = htmlAsk;

    const bids   = book.bids.slice(0, 15);
    const maxBid = Math.max(...bids.map(b => parseFloat(b[0]) * parseFloat(b[1])));
    let htmlBid  = '', bidTot = 0;
    bids.forEach(b => {
        const p = parseFloat(b[0]), v = parseFloat(b[1]), usd = p * v;
        bidTot += usd;
        const w = Math.round((usd / maxBid) * 100);
        htmlBid += `<div class="ob-row">
            <div class="ob-bg bg-green" style="width:${w}%"></div>
            <span class="c-green">${fmtPrice(p)}</span>
            <span>${v.toFixed(3)}</span>
            <span>${fmtNum(bidTot)}</span>
        </div>`;
    });
    $('obBids').innerHTML = htmlBid;
}

// ── Live tick ────────────────────────────────────────────────────────────
let prevPrice = null;

async function tick() {
    try {
        const res  = await fetch(`/api/data?symbol=${symbol}&depth=5`);
        const data = await res.json();
        if (data.error) return;

        const price = data.price;

        // ── Header price display ──
        $('hPrice').textContent = fmtPrice(price);
        if (prevPrice !== null) {
            const up = price >= prevPrice;
            $('hPrice').style.color = up ? 'var(--green)' : 'var(--red)';
            setTimeout(() => { $('hPrice').style.color = 'var(--text-main)'; }, 400);
        }
        prevPrice = price;

        // ── Metrics ──
        $('vBid').innerText = '$' + fmtNum(data.bidUSD);
        $('vAsk').innerText = '$' + fmtNum(data.askUSD);
        const imb = data.askUSD > 0 ? (data.bidUSD / data.askUSD) : 0;
        $('vImb').innerText     = imb.toFixed(2) + 'x';
        $('vImb').style.color   = imb > 1.2 ? 'var(--green)' : imb < 0.8 ? 'var(--red)' : 'white';

        updateLegend(data.bidUSD, data.askUSD);

        // ── Header 24h change: compute from klines open ──
        if (currentCandle) {
            // Use first loaded candle open to approximate 24h change
            // (klines[0].open stored separately below)
        }

        // ── Smart candle update ──
        const now        = Math.floor(Date.now() / 1000);
        const candleTime = Math.floor(now / tfSec) * tfSec;

        if (currentCandle) {
            if (candleTime === currentCandle.time) {
                // Same candle — update high, low, close; preserve open
                currentCandle.close = price;
                currentCandle.high  = Math.max(currentCandle.high, price);
                currentCandle.low   = Math.min(currentCandle.low,  price);
            } else if (candleTime > currentCandle.time) {
                // New candle
                currentCandle = {
                    time:   candleTime,
                    open:   price,
                    high:   price,
                    low:    price,
                    close:  price,
                    volume: 0,
                };
            }
            try {
                candleSeries.update(currentCandle);
                updateOhlcvBar(currentCandle, currentCandle.volume);
            } catch(e) {}
        }

        // ── Indicator live update — use candleTime so the point aligns with the current candle ──
        try {
            bidLine.update({ time: candleTime, value: data.bidUSD });
            askLine.update({ time: candleTime, value: data.askUSD });
        } catch(e) {}

        // ── Order book ──
        renderOrderBook(data.book, price);

        writeLog(
            `${symbol} | ${fmtPrice(price)} | BID: ${fmtLeg(data.bidUSD)} | ASK: ${fmtLeg(data.askUSD)} | IMB: ${imb.toFixed(2)}x`
        );
    } catch(e) {
        writeLog('Ошибка соединения...');
    }
}

// ── Timeframe buttons ────────────────────────────────────────────────────
document.querySelectorAll('.tf-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        interval     = btn.dataset.tf;
        tfSec        = parseInt(btn.dataset.sec, 10);
        currentCandle = null;
        candleSeries.setData([]);
        volumeSeries.setData([]);
        bidLine.setData([]);
        askLine.setData([]);
        loadKlines();
        loadHistory();   // re-aggregate history into the new tfSec buckets
        clearAllIndicators();
        renderIndicatorMenu();   // Rinar доступен только на 1D — недоступные пункты блокируются
        refreshIndicators();
    });
});

// ── Bootstrap ────────────────────────────────────────────────────────────
window.onload = () => {
    $('symbolInput').value  = symbol;
    $('oSym').textContent   = symbol.replace('USDT', '/USDT');
    initChart();
    loadSymbols();
    loadKlines();
    loadHistory();
    loadIndicatorCatalog();
    tick();
    setInterval(tick, 3000);
    setInterval(refreshIndicators, 15000);
};
</script>
