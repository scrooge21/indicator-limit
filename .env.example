PORT=10000
MONGODB_URI=mongodb://127.0.0.1:27017/mexc-indicator
MEXC_BASE_URL=https://api.mexc.com
MEXC_TIMEOUT_MS=10000

# История индикатора (BID/ASK). Значения по умолчанию рассчитаны на бесплатную БД ~512 МБ.
HISTORY_TTL_SECONDS=604800        # срок хранения в MongoDB (7 суток)
HISTORY_MIN_INTERVAL_MS=5000      # не чаще одной записи на символ за 5 с (раньше писалась каждая загрузка страницы/3 с)
HISTORY_MAX_DOCS=400000           # жёсткий потолок размера коллекции (~100 МБ с индексами)
HISTORY_MEMORY_PER_SYMBOL=20000   # резервный буфер в RAM на символ (работает и без MongoDB)
HISTORY_PRUNE_INTERVAL_MS=600000  # как часто удалять самые старые записи сверх лимита
LOG_INTERVAL_MS=15000             # фоновая запись закреплённых и просмотренных пар
WATCH_MAX_SYMBOLS=10              # сколько просмотренных пар писать в фоне, кроме BTC/ETH/SOL
WATCH_TTL_MS=86400000             # забыть пару, если её не открывали 24 часа

# Необязательный ключ для ручной записи POST /api/history (заголовок X-API-Key).
# Пусто — запись открыта без ключа (любой, кто знает адрес, может добавлять точки). Чтобы закрыть, задайте длинную случайную строку, например: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
